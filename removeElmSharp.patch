-                    prevItem = target;
-                }
-                else
-                {
-                    target.Scale = new Vector3(0.0f, 0.0f, 1.0f);
-                }
-            }
-
-            if (StepSize == 0)
-            {
-                if (LayoutOrientation == Orientation.Horizontal)
