-            GCHandle gch = GCHandle.Alloc(tcs);
-            Interop.Elementary.elm_atspi_bridge_utils_say(text, discardable, AtspiSignalCallback, GCHandle.ToIntPtr(gch));
-            return tcs.Task;
-        }
-    }
